{
  "name": "obsen-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Obsen desktop workspace built with Electron, TypeScript and React",
  "main": "dist/app.asar/main.cjs",
  "scripts": {
    "generate:electron-types": "node libs/positron/scripts/generate-types.mjs",
    "dev:web": "vite --open /",
    "build:web": "npm run build:icon-index && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "api:inventory": "node scripts/api-inventory.mjs",
    "build:icon-index": "node scripts/build-icon-index.mjs",
    "test:workspace": "esbuild scripts/workspace-open-link-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/workspace-smoke.cjs && node dist/workspace-smoke.cjs",
    "test:commands": "esbuild scripts/commands-smoke.ts --bundle --platform=node --format=cjs --external:yaml --external:electron --alias:original-fs=node:fs --outfile=dist/commands-smoke.cjs && node dist/commands-smoke.cjs",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:electron:editor-followups": "node scripts/electron-smoke.mjs --editor-followups",
    "test:electron:bases-audit": "node scripts/electron-smoke.mjs --bases-audit",
    "test:plugins": "esbuild scripts/community-plugins-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/community-plugins-smoke.cjs && node dist/community-plugins-smoke.cjs",
    "typecheck": "tsc --noEmit",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --external:@electron/remote --outfile=dist/preload.cjs",
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --external:@electron/remote/main --outfile=dist/main.cjs",
    "build:renderer": "esbuild src/renderer/main.tsx --bundle --platform=browser --format=iife --external:electron --external:original-fs --external:node:* --outfile=dist/renderer.js",
    "build:css": "tailwindcss -i src/renderer/styles.css -o dist/styles.css --minify",
    "build:html": "node scripts/copy-html.mjs",
    "build": "npm run build:icon-index && npm run typecheck && npm run build:css && node scripts/build-runtime.mjs",
    "start": "npm run build && electron .",
    "build:graph:wasm": "node scripts/build-graph-wasm.mjs",
    "test:editor": "esbuild scripts/editor-parity-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/editor-parity-smoke.cjs && node dist/editor-parity-smoke.cjs",
    "test:editor-followups": "esbuild scripts/editor-followups-node-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/editor-followups-smoke.cjs && node dist/editor-followups-smoke.cjs",
    "test:sync": "esbuild scripts/sync-model-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/sync-model-smoke.cjs && node dist/sync-model-smoke.cjs",
    "test:graph": "node scripts/graph-append-smoke.mjs",
    "test:bases": "esbuild scripts/bases-smoke.ts --bundle --platform=node --format=cjs --external:electron --alias:original-fs=node:fs --outfile=dist/bases-smoke.cjs && node dist/bases-smoke.cjs",
    "check:locales": "node scripts/check-locale-keys.mjs",
    "check:copy": "node scripts/find-hardcoded-copy.mjs",
    "test": "npm run build:icon-index && npm run typecheck && npm run check:locales && npm run test:workspace && npm run test:commands && npm run test:plugins && npm run test:editor && npm run test:editor-followups && npm run test:sync && npm run test:bases && npm run test:graph"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@cubone/react-file-manager": "^1.35.0",
    "@electron/remote": "2.1.3",
    "@jsonjoy.com/fs-fsa-to-node": "^4.80.0",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "0.6.0",
    "@noble/hashes": "^2.4.0",
    "@types/markdown-it": "^14.1.2",
    "codemirror": "5.64.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "i18next": "^25.10.10",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "memfs": "^4.80.0",
    "mermaid": "11.13.0",
    "moment": "^2.29.4",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "5.3.31",
    "pele": "^1.3.0",
    "prismjs": "1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "reveal.js": "4.3.1",
    "turndown": "7.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@electron/docs-parser": "^3.0.2",
    "@electron/typescript-definitions": "^9.2.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "electron": "43.7.7",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "allowScripts": {
    "@codemirror/state@6.5.0": true,
    "@codemirror/view@6.38.6": true,
    "@codemirror/commands@6.8.1": true,
    "@codemirror/lang-markdown@6.3.3": true,
    "moment@2.29.4": true,
    "markdown-it@14.1.0": true,
    "@types/markdown-it@14.1.2": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.25.12": true
  }
}
